// =====================================================================
// AgriConnect — schéma Prisma v2 (consignation avec intermédiation)
// MySQL. Les montants sont en Decimal ; la devise est dans PlatformSetting.
// Règle d'or : un acheteur et un fournisseur ne sont JAMAIS liés par une relation
// (ni conversation, ni commande directe) — tout passe par l'équipe AgriConnect.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

enum Role {
  ROOT
  ADMIN
  AGENT
  SUPPLIER
  BUYER
  DRIVER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  ID_CARD
  BUSINESS_REGISTRATION
  FARM_PROOF
  OTHER
}

enum BuyerType {
  RETAILER
  FARMER
  WHOLESALER
  OTHER
}

enum PayoutMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
}

enum UnitOfMeasure {
  KG
  TON
  BAG
  CRATE
  PIECE
  LITER
  BUNCH
}

enum StorageType {
  SUPPLIER_SITE
  HUB
}

enum LotStatus {
  PENDING_VALIDATION
  AVAILABLE
  FULLY_RESERVED
  SOLD_OUT
  EXPIRED
  RETURNED
  REJECTED
  WITHDRAWN
}

enum StockMovementType {
  RECEIVED
  RESERVED
  RESERVATION_RELEASED
  SOLD
  EXPIRED
  RETURNED
  ADJUSTMENT
}

enum OrderStatus {
  QUOTED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum FulfillmentMode {
  HUB_PICKUP
  AGENCY_DELIVERY
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
}

enum PaymentEntryStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  ON_HOLD
  READY
  PAID
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum CompensationReason {
  EXPIRED_UNSOLD
  LOST_OR_DAMAGED
  OTHER
}

enum CompensationStatus {
  PENDING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

enum ReferralKind {
  BUYER
  SUPPLIER
}

enum ReferralStatus {
  PENDING
  ELIGIBLE
  PAID
  REJECTED
}

enum BuyerFeeType {
  NONE
  FIXED
  PERCENT
}

enum AgentKind {
  HUMAN
  AI
}

enum AgentAutonomy {
  SUGGEST_ONLY
  ACT_WITH_APPROVAL
  AUTONOMOUS
}

enum Capability {
  BUYER_SUPPORT
  SUPPLIER_SUPPORT
  ORDER_PROCESSING
  STOCK_VALIDATION
  PAYMENT_FOLLOWUP
  DISPATCH_COORDINATION
  USER_VERIFICATION
  DISPUTE_HANDLING
}

enum ConversationType {
  BUYER_SUPPORT
  SUPPLIER_SUPPORT
}

enum ConversationStatus {
  OPEN
  WAITING_CUSTOMER
  CLOSED
}

enum SenderType {
  CUSTOMER
  AGENT
  SYSTEM
}

enum TermsDocument {
  CGU
  BUYER_TERMS
  SUPPLIER_CONSIGNMENT_TERMS
}

// ---------------------------------------------------------------------
// UTILISATEURS & PROFILS
// ---------------------------------------------------------------------

model User {
  id                 String             @id @default(uuid())
  fullName           String
  phone              String             @unique
  email              String?            @unique
  passwordHash       String
  role               Role
  status             AccountStatus      @default(ACTIVE)
  suspendedAt        DateTime?
  suspensionReason   String?            @db.Text
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?              @relation("UserVerifiedBy", fields: [verifiedById], references: [id])
  verifiedUsers      User[]             @relation("UserVerifiedBy")
  referralCode       String             @unique
  avatarUrl          String?            @db.VarChar(500)
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  supplierProfile    SupplierProfile?
  buyerProfile       BuyerProfile?
  driverProfile      DriverProfile?
  agent              Agent?
  refreshTokens      RefreshToken[]
  payoutAccounts     PayoutAccount[]
  documents          VerificationDocument[] @relation("DocumentOwner")
  reviewedDocuments  VerificationDocument[] @relation("DocumentReviewer")
  conversations      Conversation[]
  messagesSent       Message[]
  orders             Order[]
  paymentsRecorded   Payment[]
  payoutsPaid        SupplierPayout[]
  compensationsApproved SupplierCompensation[]
  referralsMade      Referral[]         @relation("Referrer")
  referralReceived   Referral?          @relation("Referred")
  termsAcceptances   TermsAcceptance[]
  auditLogs          AuditLog[]
  stockMovements     StockMovement[]

  @@index([role, status])
  @@index([verificationStatus])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model SupplierProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName    String
  description String?  @db.Text
  city        String
  address     String?  @db.VarChar(500)
  latitude    Float?
  longitude   Float?
  zoneId      String?
  zone        Zone?    @relation(fields: [zoneId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lots          StockLot[]
  payouts       SupplierPayout[]
  compensations SupplierCompensation[]
}

model BuyerProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  buyerType    BuyerType @default(RETAILER)
  businessName String?
  city         String
  address      String?   @db.VarChar(500)
  latitude     Float?
  longitude    Float?
  zoneId       String?
  zone         Zone?     @relation(fields: [zoneId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model DriverProfile {
  id           String          @id @default(uuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId     String
  agency       TransportAgency @relation(fields: [agencyId], references: [id])
  vehicleType  String?
  plateNumber  String?
  isAvailable  Boolean         @default(false)
  currentLat   Float?
  currentLng   Float?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  deliveries Delivery[]

  @@index([agencyId, isAvailable])
}

model PayoutAccount {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  method        PayoutMethod
  provider      String?
  accountNumber String
  accountName   String?
  isDefault     Boolean      @default(false)
  createdAt     DateTime     @default(now())

  supplierPayouts SupplierPayout[]

  @@index([userId])
}

model VerificationDocument {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  type         DocumentType
  fileUrl      String             @db.VarChar(500)
  publicId     String?
  status       VerificationStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?              @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  note         String?            @db.Text
  createdAt    DateTime           @default(now())

  @@index([userId])
}

model TermsAcceptance {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document     TermsDocument
  version      String
  ipAddress    String?
  acceptedAt   DateTime      @default(now())

  @@unique([userId, document, version])
}

// ---------------------------------------------------------------------
// AGENTS AGRICONNECT (humains aujourd'hui, IA demain)
// Un agent n'est pas un User : un agent HUMAN est relié à un User (rôle AGENT),
// un agent AI n'a pas de compte (userId null). Ses "rôles" sont des capacités
// modifiables sans migration.
// ---------------------------------------------------------------------

model Agent {
  id           String            @id @default(uuid())
  kind         AgentKind         @default(HUMAN)
  displayName  String
  userId       String?           @unique
  user         User?             @relation(fields: [userId], references: [id])
  capabilities AgentCapability[]
  autonomy     AgentAutonomy?
  isActive     Boolean           @default(true)
  aiProvider   String?
  aiModel      String?
  aiConfig     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  conversations  Conversation[]
  messages       Message[]
  orders         Order[]
  lotsCreated    StockLot[]        @relation("LotCreatedByAgent")
  lotsValidated  StockLot[]        @relation("LotValidatedByAgent")
  stockMovements StockMovement[]
  auditLogs      AuditLog[]

  @@index([kind, isActive])
}

model AgentCapability {
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  capability Capability

  @@id([agentId, capability])
}

// ---------------------------------------------------------------------
// ZONES, AGENCES DE TRANSPORT, POINTS DE DÉPÔT / RETRAIT
// Une seule ligne dans chaque table au MVP ; prêt pour plusieurs agences/zones.
// ---------------------------------------------------------------------

model Zone {
  id        String   @id @default(uuid())
  name      String   @unique
  city      String?
  region    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  agencies   AgencyZone[]
  hubs       Hub[]
  lots       StockLot[]
  suppliers  SupplierProfile[]
  buyers     BuyerProfile[]
  orders     Order[]
}

model TransportAgency {
  id                  String    @id @default(uuid())
  name                String    @unique
  contactName         String?
  phone               String
  email               String?
  insuranceProvider   String?
  insurancePolicyNumber String?
  insuranceExpiresAt  DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  zones      AgencyZone[]
  drivers    DriverProfile[]
  deliveries Delivery[]
}

model AgencyZone {
  agencyId String
  agency   TransportAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  zoneId   String
  zone     Zone            @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  baseFee  Decimal         @default(0) @db.Decimal(14, 2)
  perKmFee Decimal         @default(0) @db.Decimal(14, 2)
  isActive Boolean         @default(true)

  @@id([agencyId, zoneId])
}

model Hub {
  id             String   @id @default(uuid())
  name           String
  address        String   @db.VarChar(500)
  city           String?
  latitude       Float
  longitude      Float
  zoneId         String
  zone           Zone     @relation(fields: [zoneId], references: [id])
  acceptsDropoff Boolean  @default(true)
  acceptsPickup  Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  lots       StockLot[]
  orders     Order[]
  deliveries Delivery[]
}

// ---------------------------------------------------------------------
// CATALOGUE & STOCK (consignation)
// ---------------------------------------------------------------------

model ProductCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id           String          @id @default(uuid())
  categoryId   String
  category     ProductCategory @relation(fields: [categoryId], references: [id])
  name         String
  unit         UnitOfMeasure
  description  String?         @db.Text
  imageUrl     String?         @db.VarChar(500)
  isPerishable Boolean         @default(true)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  lots          StockLot[]
  conversations Conversation[]

  @@unique([categoryId, name])
}

// Lot confié par un fournisseur. agreedUnitPrice = prix convenu avec le fournisseur
// (prix garanti : base de l'indemnisation si le lot périme sans acheteur).
model StockLot {
  id                 String      @id @default(uuid())
  lotCode            String      @unique
  supplierId         String
  supplier           SupplierProfile @relation(fields: [supplierId], references: [id])
  productId          String
  product            Product     @relation(fields: [productId], references: [id])
  zoneId             String
  zone               Zone        @relation(fields: [zoneId], references: [id])
  storageType        StorageType @default(SUPPLIER_SITE)
  hubId              String?
  hub                Hub?        @relation(fields: [hubId], references: [id])
  pickupAddress      String?     @db.VarChar(500)
  pickupLatitude     Float?
  pickupLongitude    Float?

  agreedUnitPrice    Decimal     @db.Decimal(14, 2)
  quantityInitial    Decimal     @db.Decimal(12, 3)
  quantityAvailable  Decimal     @db.Decimal(12, 3)
  quantityReserved   Decimal     @default(0) @db.Decimal(12, 3)
  quantitySold       Decimal     @default(0) @db.Decimal(12, 3)
  quantityLost       Decimal     @default(0) @db.Decimal(12, 3)

  packagingNote      String?     @db.Text
  qualityNote        String?     @db.Text
  harvestedAt        DateTime?
  expiresAt          DateTime?
  status             LotStatus   @default(PENDING_VALIDATION)

  createdByAgentId   String?
  createdByAgent     Agent?      @relation("LotCreatedByAgent", fields: [createdByAgentId], references: [id])
  validatedByAgentId String?
  validatedByAgent   Agent?      @relation("LotValidatedByAgent", fields: [validatedByAgentId], references: [id])
  validatedAt        DateTime?
  rejectionReason    String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  images        LotImage[]
  movements     StockMovement[]
  orderItems    OrderItem[]
  compensations SupplierCompensation[]

  @@index([status, productId, zoneId])
  @@index([supplierId])
  @@index([expiresAt])
}

model LotImage {
  id       String   @id @default(uuid())
  lotId    String
  lot      StockLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  url      String   @db.VarChar(500)
  publicId String?
  position Int      @default(0)

  @@index([lotId])
}

// Journal de stock : chaque variation de quantité est tracée.
model StockMovement {
  id            String            @id @default(uuid())
  lotId         String
  lot           StockLot          @relation(fields: [lotId], references: [id])
  type          StockMovementType
  quantityDelta Decimal           @db.Decimal(12, 3)
  orderItemId   String?
  orderItem     OrderItem?        @relation(fields: [orderItemId], references: [id])
  note          String?           @db.Text
  actorUserId   String?
  actorUser     User?             @relation(fields: [actorUserId], references: [id])
  actorAgentId  String?
  actorAgent    Agent?            @relation(fields: [actorAgentId], references: [id])
  createdAt     DateTime          @default(now())

  @@index([lotId, createdAt])
}

// ---------------------------------------------------------------------
// COMMANDES, PAIEMENTS, REVERSEMENTS
// ---------------------------------------------------------------------

model Order {
  id               String          @id @default(uuid())
  orderNumber      String          @unique
  buyerId          String
  buyer            User            @relation(fields: [buyerId], references: [id])
  handledByAgentId String?
  handledByAgent   Agent?          @relation(fields: [handledByAgentId], references: [id])
  conversationId   String?
  conversation     Conversation?   @relation(fields: [conversationId], references: [id])

  status           OrderStatus     @default(QUOTED)
  paymentStatus    PaymentStatus   @default(UNPAID)
  fulfillmentMode  FulfillmentMode
  pickupHubId      String?
  pickupHub        Hub?            @relation(fields: [pickupHubId], references: [id])
  deliveryZoneId   String?
  deliveryZone     Zone?           @relation(fields: [deliveryZoneId], references: [id])
  deliveryAddress  String?         @db.VarChar(500)
  deliveryLatitude Float?
  deliveryLongitude Float?

  reservedUntil    DateTime?
  subtotal         Decimal         @db.Decimal(14, 2)
  buyerFee         Decimal         @default(0) @db.Decimal(14, 2)
  deliveryFee      Decimal         @default(0) @db.Decimal(14, 2)
  total            Decimal         @db.Decimal(14, 2)
  commissionTotal  Decimal         @default(0) @db.Decimal(14, 2)

  notes            String?         @db.Text
  confirmedAt      DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancellationReason String?       @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items      OrderItem[]
  payments   Payment[]
  payouts    SupplierPayout[]
  deliveries Delivery[]

  @@index([buyerId, status])
  @@index([status, createdAt])
}

// Prix et commission figés au moment de la commande (historique fiable).
// Base de commission = quantity × supplierUnitPrice ; unitPrice = prix payé par l'acheteur.
model OrderItem {
  id                 String     @id @default(uuid())
  orderId            String
  order              Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lotId              String
  lot                StockLot   @relation(fields: [lotId], references: [id])
  deliveryId         String?
  delivery           Delivery?  @relation(fields: [deliveryId], references: [id])
  quantity           Decimal    @db.Decimal(12, 3)
  unitPrice          Decimal    @db.Decimal(14, 2)
  supplierUnitPrice  Decimal    @db.Decimal(14, 2)
  lineTotal          Decimal    @db.Decimal(14, 2)
  commissionRate    Decimal    @db.Decimal(5, 4)
  commissionAmount   Decimal    @db.Decimal(14, 2)
  supplierNetAmount  Decimal    @db.Decimal(14, 2)

  movements StockMovement[]

  @@index([orderId])
  @@index([lotId])
}

model Payment {
  id           String             @id @default(uuid())
  orderId      String
  order        Order              @relation(fields: [orderId], references: [id])
  amount       Decimal            @db.Decimal(14, 2)
  method       PaymentMethod
  status       PaymentEntryStatus @default(PENDING)
  provider     String?
  reference    String?
  paidAt       DateTime?
  recordedById String?
  recordedBy   User?              @relation(fields: [recordedById], references: [id])
  createdAt    DateTime           @default(now())

  @@index([orderId])
}

// Un reversement par fournisseur et par commande.
model SupplierPayout {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id])
  supplierId      String
  supplier        SupplierProfile @relation(fields: [supplierId], references: [id])
  grossAmount     Decimal        @db.Decimal(14, 2)
  commissionAmount Decimal       @db.Decimal(14, 2)
  netAmount       Decimal        @db.Decimal(14, 2)
  status          PayoutStatus   @default(ON_HOLD)
  payoutAccountId String?
  payoutAccount   PayoutAccount? @relation(fields: [payoutAccountId], references: [id])
  reference       String?
  paidAt          DateTime?
  paidById        String?
  paidBy          User?          @relation(fields: [paidById], references: [id])
  createdAt       DateTime       @default(now())

  @@unique([orderId, supplierId])
  @@index([supplierId, status])
}

// Indemnisation du fournisseur (produit périmé sans acheteur, perte, casse...).
// amount = quantity × unitPrice (prix convenu) × taux d'indemnisation.
model SupplierCompensation {
  id           String             @id @default(uuid())
  supplierId   String
  supplier     SupplierProfile    @relation(fields: [supplierId], references: [id])
  lotId        String
  lot          StockLot           @relation(fields: [lotId], references: [id])
  deliveryId   String?
  delivery     Delivery?          @relation(fields: [deliveryId], references: [id])
  reason       CompensationReason
  quantity     Decimal            @db.Decimal(12, 3)
  unitPrice    Decimal            @db.Decimal(14, 2)
  rate         Decimal            @default(1) @db.Decimal(5, 4)
  amount       Decimal            @db.Decimal(14, 2)
  status       CompensationStatus @default(PENDING_APPROVAL)
  note         String?            @db.Text
  approvedById String?
  approvedBy   User?              @relation(fields: [approvedById], references: [id])
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime           @default(now())

  @@index([supplierId, status])
  @@index([lotId])
}

// ---------------------------------------------------------------------
// LIVRAISON (agence de transport partenaire, dispatch "pull")
// Une commande peut avoir plusieurs livraisons (une par point d'enlèvement).
// ---------------------------------------------------------------------

model Delivery {
  id                    String          @id @default(uuid())
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id])
  agencyId              String
  agency                TransportAgency @relation(fields: [agencyId], references: [id])
  driverId              String?
  driver                DriverProfile?  @relation(fields: [driverId], references: [id])
  status                DeliveryStatus  @default(PENDING)

  pickupHubId           String?
  pickupHub             Hub?            @relation(fields: [pickupHubId], references: [id])
  pickupAddress         String?         @db.VarChar(500)
  pickupLatitude        Float?
  pickupLongitude       Float?
  dropoffAddress        String         @db.VarChar(500)
  dropoffLatitude       Float?
  dropoffLongitude      Float?

  distanceKm            Float?
  agencyCost            Decimal         @default(0) @db.Decimal(14, 2)
  deliveryFee           Decimal         @default(0) @db.Decimal(14, 2)
  insuredValue          Decimal?        @db.Decimal(14, 2)
  insurancePolicyNumber String?

  acceptedAt            DateTime?
  pickedUpAt            DateTime?
  deliveredAt           DateTime?
  failureReason         String?         @db.Text
  incidentNote          String?         @db.Text
  proofOfDeliveryUrl    String?         @db.VarChar(500)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  items         OrderItem[]
  compensations SupplierCompensation[]

  @@index([agencyId, status])
  @@index([driverId, status])
  @@index([orderId])
}

// ---------------------------------------------------------------------
// PARRAINAGE (montant fixe, acheteurs et fournisseurs vérifiés)
// ---------------------------------------------------------------------

model Referral {
  id              String         @id @default(uuid())
  referrerId      String
  referrer        User           @relation("Referrer", fields: [referrerId], references: [id])
  referredId      String         @unique
  referred        User           @relation("Referred", fields: [referredId], references: [id])
  kind            ReferralKind
  status          ReferralStatus @default(PENDING)
  rewardAmount    Decimal?       @db.Decimal(14, 2)
  eligibleAt      DateTime?
  paidAt          DateTime?
  rejectionReason String?        @db.Text
  createdAt       DateTime       @default(now())

  @@index([referrerId, status])
}

// ---------------------------------------------------------------------
// MESSAGERIE (client ↔ équipe AgriConnect, jamais acheteur ↔ fournisseur)
// ---------------------------------------------------------------------

model Conversation {
  id                String             @id @default(uuid())
  type              ConversationType
  customerId        String
  customer          User               @relation(fields: [customerId], references: [id])
  assignedAgentId   String?
  assignedAgent     Agent?             @relation(fields: [assignedAgentId], references: [id])
  productId         String?
  product           Product?           @relation(fields: [productId], references: [id])
  status            ConversationStatus @default(OPEN)
  subject           String?
  escalatedAt       DateTime?
  escalationReason  String?            @db.Text
  lastMessageAt     DateTime           @default(now())
  createdAt         DateTime           @default(now())

  messages Message[]
  orders   Order[]

  @@index([customerId])
  @@index([status, lastMessageAt])
  @@index([assignedAgentId, status])
}

model Message {
  id            String       @id @default(uuid())
  conversationId String
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType    SenderType
  senderUserId  String?
  senderUser    User?        @relation(fields: [senderUserId], references: [id])
  senderAgentId String?
  senderAgent   Agent?       @relation(fields: [senderAgentId], references: [id])
  body          String       @db.Text
  attachmentUrl String?      @db.VarChar(500)
  isInternal    Boolean      @default(false)
  readAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------
// CONFIGURATION & AUDIT
// ---------------------------------------------------------------------

// Ligne unique (id = 1). Les taux sont figés sur chaque OrderItem à la commande.
model PlatformSetting {
  id                     Int          @id @default(1)
  currency               String       @default("XAF")
  supplierCommissionRate Decimal      @default(0) @db.Decimal(5, 4)
  buyerFeeType           BuyerFeeType @default(NONE)
  buyerFeeValue          Decimal      @default(0) @db.Decimal(14, 4)
  transportMarkupRate    Decimal      @default(0) @db.Decimal(5, 4)
  referralBuyerReward    Decimal      @default(5000) @db.Decimal(14, 2)
  referralSupplierReward Decimal      @default(10000) @db.Decimal(14, 2)
  reservationHours       Int          @default(24)
  expiryCompensationRate Decimal      @default(1) @db.Decimal(5, 4)
  updatedAt              DateTime     @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actorUser    User?    @relation(fields: [actorUserId], references: [id])
  actorAgentId String?
  actorAgent   Agent?   @relation(fields: [actorAgentId], references: [id])
  action       String
  entityType   String
  entityId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([actorAgentId, createdAt])
}
