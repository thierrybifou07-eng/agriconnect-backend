# Base de données MySQL
DATABASE_URL="mysql://user:password@localhost:3306/agriconnect"

# Authentification
JWT_SECRET="change_this_secret_en_production"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_TTL_DAYS=30

# Serveur
PORT=4000

# Cloudinary (stockage des médias)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Emails transactionnels (SMTP générique - Gmail, SendGrid, Mailgun, etc.)
# Si SMTP_HOST est vide, les emails sont simplement journalisés (pratique en dev local)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AgriConnect <no-reply@agriconnect.local>"
