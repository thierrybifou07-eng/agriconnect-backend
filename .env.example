# Base de données MySQL
DATABASE_URL="mysql://user:password@localhost:3306/agriconnect"

# Base VIDE dédiée au contrôle de dérive (npm run db:drift). Prisma la crée et
# la détruit pour générer les migrations sur une base propre. L'utilisateur MySQL
# doit avoir les droits CREATE et DROP sur cette base.
# SHADOW_DATABASE_URL="mysql://user:password@localhost:3306/agriconnect_shadow"

# Authentification
JWT_SECRET=your_jwt_secret_here
# Durée du jeton d'ACCÈS : courte par conception. C'est le refresh token
# (REFRESH_TOKEN_TTL_DAYS) qui porte la durée de la connexion.
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_TTL_DAYS=30
# Nombre de sessions ouvertes simultanément par compte. Au-delà, la plus
# ancienne est fermée : un compte qui s'accumule depuis des appareils perdus
# resterait connectable indéfiniment.
SESSION_MAX_PER_USER=5
# Fenêtre de tolérance après le remplacement d'un jeton de rafraîchissement.
# Deux refreshs parallèles d'une même application mobile sont ordinaires ; sans
# ce délai, le serveur y verrait un vol et détruirait la session d'un
# utilisateur légitime. Au-delà, un jeton déjà remplacé est traité comme volé.
REFRESH_REUSE_GRACE_SECONDS=30

# Récupération de compte
# Fenêtre de validité du lien de réinitialisation, en minutes. Court : une
# réinitialisation se fait sous la contrainte, et un lien qui traîne des
# semaines dans une boîte n'a plus lieu d'être utile.
PASSWORD_RESET_TTL_MINUTES=15
# Durée de validité du lien de vérification d'adresse, en heures
EMAIL_VERIFICATION_TTL_HOURS=24
# Délai minimum avant de renvoyer un lien de vérification, en minutes
RESEND_VERIFICATION_COOLDOWN_MINUTES=5

# Serveur
PORT=4000
# Origine(s) autorisée(s) par CORS, séparées par des virgules, ou '*' pour tout autoriser.
CORS_IO="http://localhost:5173"

# Tâches planifiées (src/jobs) : libération des devis expirés, péremption des
# lots et alertes d'expiration. Elles démarrent avec le serveur, sauf si
# NODE_ENV=test (suite de tests) ou DISABLE_JOBS=true : un deuxième serveur sur
# la même base ne doit pas doubler le travail.
# DISABLE_JOBS=false

# Adresse publique du front (Flutter, web). Sert à construire les liens envoyés
# par email : réinitialisation de mot de passe et vérification d'adresse.
# Le backend sert lui-même le formulaire à partir du lien, et redirige vers
# APP_URL une fois l'action faite : la variable reste donc nécessaire même si
# les liens pointent d'abord ici.
APP_URL="http://localhost:3000"

# Stockage des fichiers (local)
# Dossier racine des uploads (avatars, photos de lots et d'annonces, documents
# de vérification). Valeur par défaut : <racine projet>/uploads
# UPLOADS_DIR=./uploads

# Secret dédié aux liens de fichiers privés (documents de vérification).
# Indépendant de JWT_SECRET : il signe les jetons d'accès aux fichiers.
# OBLIGATOIRE en production, et différent de JWT_SECRET : le serveur refuse de
# démarrer sinon (voir src/server.js). Hors production, JWT_SECRET est
# accepté en repli, avec un simple avertissement.
# Valeur d'exemple factice, à remplacer par une valeur longue et aléatoire.
SECRET_FILE_TOKEN=exemple-secret-liens-fichiers-a-remplacer

# Emails transactionnels (SMTP générique : Gmail, SendGrid, Mailgun, etc.)
# Si SMTP_HOST est vide ou absent, les emails ne sont pas envoyés et le service
# journalise un avertissement : aucune inscription n'échoue pour autant.
# SMTP_HOST est le nom d'hôte du serveur SMTP (ex. smtp.gmail.com), et non une
# URL d'interface web comme Mailpit.
SMTP_HOST=
SMTP_PORT=587
# true pour un port 465 (TLS implicite), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Adresse d'expédition. Les serveurs SMTP refusent une adresse nue :
# utilisez la forme "Nom <adresse@domaine>".
EMAIL_SENDER="AgriConnect <no-reply@votre-domaine.com>"

# Modèle utilisé pour la fiche d'agent IA locale créée par npm run seed:demo.
# OLLAMA_MODEL=

# Piège à mail local (MailDev) : le serveur SMTP écoute sur 1025 et son
# interface web sur 1080. Ce sont deux ports différents — 1080 n'accepte pas
# SMTP, un envoi vers ce port échoue sans bruit.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
