{
  "name": "agriconnect-backend",
  "version": "2.0.0",
  "description": "Backend API pour AgriConnect - Marketplace agricole (MVP)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "create:root": "node scripts/create-root.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "joi": "^18.2.8",
    "jsonwebtoken": "^9.0.3",
    "juice": "^12.1.2",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "supertest": "^7.3.0",
    "vitest": "^3.2.7"
  }
}
