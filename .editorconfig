# Le projet est en 2 espaces : l'IDE a réécrit plusieurs fichiers en 4 lors d'une
# phase de durcissement, et l'écart s'était propagé. Ce fichier verrouille la
# règle pour tout le monde, éditeur par éditeur.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
