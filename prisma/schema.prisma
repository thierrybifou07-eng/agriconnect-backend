generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tables de référence ("lookup tables")
//
// Choix : Role, statuts et catégories vivent dans des tables plutôt que des
// enums Postgres, pour permettre d'ajouter une valeur (ex: une nouvelle
// catégorie d'annonce) par une simple insertion en base, sans migration ni
// déploiement de code.
//
// Exception assumée : OrderStatus et DeliveryStatus restent des enums Postgres.
// Ce sont des machines à états dont chaque transition est déjà câblée dans le
// code (VALID_TRANSITIONS) - les convertir en table ne dispenserait de toute
// façon pas d'écrire le code qui gère un nouvel état, mais ferait perdre la
// garantie d'intégrité native de la base.
// ---------------------------------------------------------------------------

model Role {
  id        Int   @id @default(autoincrement())
  code      String   @unique // FARMER, BUYER, DRIVER, ADMIN, ROOT
  label     String
  level     Int      @default(10) // hiérarchie : 10 = opérationnel, 50 = admin, 100 = root
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]

  @@index([level])
}

model UserStatus {
  id        Int   @id @default(autoincrement())
  code      String   @unique // ACTIVE, SUSPENDED
  label     String
  createdAt DateTime @default(now())

  users User[]
}

model ListingStatus {
  id        Int   @id @default(autoincrement())
  code      String   @unique // ACTIVE, SOLD, INACTIVE
  label     String
  createdAt DateTime @default(now())

  listings Listing[]
}

model ListingCategory {
  id        Int   @id @default(autoincrement())
  code      String   @unique // CEREALES, LEGUMES, FRUITS, ...
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  listings Listing[]
}

model DeliveryMode {
  id        Int   @id @default(autoincrement())
  code      String   @unique // PICKUP, DELIVERY
  label     String
  createdAt DateTime @default(now())

  orders Order[]
}

model MediaType {
  id        Int   @id @default(autoincrement())
  code      String   @unique // IMAGE, VIDEO, DOCUMENT
  label     String
  createdAt DateTime @default(now())

  mimeTypes MimeType[]
  media     Media[]
}

model MimeType {
  id          Int    @id @default(autoincrement())
  code        String    @unique // image/jpeg, image/png, video/mp4, application/pdf...
  extension   String    // .jpg, .png, .mp4, .pdf
  mediaType   MediaType @relation(fields: [mediaTypeId], references: [id])
  mediaTypeId Int
  createdAt   DateTime  @default(now())

  media Media[]

  @@index([mediaTypeId])
}

// ---------------------------------------------------------------------------
// Media : table générique pour tous les fichiers uploadés (photos d'annonce,
// avatar utilisateur), extensible demain à d'autres porteurs sans nouvelle
// table. Exactement un des deux champs "owner" doit être renseigné - contrainte
// vérifiée côté application (Prisma ne supporte pas nativement les CHECK
// constraints déclaratifs de façon portable).
// ---------------------------------------------------------------------------

model Media {
  id             Int    @id @default(autoincrement())
  ownerUser      User?     @relation(fields: [ownerUserId], references: [id])
  ownerUserId    Int?
  ownerListing   Listing?  @relation(fields: [ownerListingId], references: [id])
  ownerListingId Int?
  mediaType      MediaType @relation(fields: [mediaTypeId], references: [id])
  mediaTypeId    Int
  mimeType       MimeType  @relation(fields: [mimeTypeId], references: [id])
  mimeTypeId     Int
  url            String    @db.VarChar(500)
  fileSize       Int?
  width          Int?
  height         Int?
  isPrimary      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([ownerUserId])
  @@index([ownerListingId])
}

enum OrderStatus {
  PENDING
  READY_FOR_PICKUP
  IN_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model User {
  id           Int     @id @default(autoincrement())
  firstname     String
  lastname     String
  phone        String     @unique
  email        String    @unique
  password     String
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       Int
  userStatus   UserStatus @relation(fields: [userStatusId], references: [id])
  userStatusId Int
  location     String?
  latitude     Float?
  longitude    Float?
  isAvailable  Boolean    @default(true)
  vehicleType  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  // Renomme depuis "verified" : le nom seul ne disait pas ce qui etait verifie,
  // et l'indicateur est desormais expose dans le jeton d'acces. La colonne
  // existait depuis la premiere migration sans jamais etre ecrite ni lue.
  emailVerified Boolean   @default(false)

  listings              Listing[]
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsFarmer Conversation[] @relation("FarmerConversations")
  messages              Message[]
  ordersAsBuyer         Order[]        @relation("BuyerOrders")
  ordersAsFarmer        Order[]        @relation("FarmerOrders")
  deliveriesAsDriver    Delivery[]     @relation("DriverDeliveries")
  refreshTokens         RefreshToken[]
  sessions              Session[]
  media                 Media[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([roleId])
  @@index([userStatusId])
}

// Verification de l'adresse email.
//
// Table separee du jeton de reinitialisation de mot de passe, volontairement :
// deux usages, deux durees de vie, deux facons de purger. Les regrouper sous une
// colonne "type" ferait qu'une erreur de filtre envoie un lien au mauvais effet.
//
// La verification n'est pas bloquante : elle renseigne le client et le
// scoring, elle n'interdit rien. Un compte non verifie utilise l'API
// normalement, donc une adresse perdue ne verrouille personne hors du MVP.
model EmailVerificationToken {
  id    Int    @id @default(autoincrement())
  token String @unique
  user  User   @relation(fields: [userId], references: [id])
  userId Int
  // 24 h : assez pour que le mail arrive et qu'on le lise, pas assez pour qu'un
  // lien depose dans une boite reste utile indefiniment.
  expiresAt DateTime
  // Rempli au premier usage. Le jeton n'est jamais supprime : une verification
  // doit pouvoir dire " deja verifie, il y a trois jours" plutot que " inconnu".
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Listing {
  id          Int          @id @default(autoincrement())
  farmer      User            @relation(fields: [farmerId], references: [id])
  farmerId    Int
  title       String
  category    ListingCategory @relation(fields: [categoryId], references: [id])
  categoryId  Int
  price       Decimal        @db.Decimal(10, 2)
  quantity    Decimal        @db.Decimal(12, 3)
  unit        String
  location    String
  latitude    Float?
  longitude   Float?
  description String?  @db.Text
  status      ListingStatus   @relation(fields: [statusId], references: [id])
  statusId    Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  conversations Conversation[]
  orders        Order[]
  media         Media[]

  @@index([categoryId])
  @@index([location])
  @@index([farmerId])
  @@index([statusId])
}

model Conversation {
  id        Int   @id @default(autoincrement())
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId Int
  buyer     User     @relation("BuyerConversations", fields: [buyerId], references: [id])
  buyerId   Int
  farmer    User     @relation("FarmerConversations", fields: [farmerId], references: [id])
  farmerId  Int
  createdAt DateTime @default(now())

  messages Message[]

  @@unique([listingId, buyerId])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId Int
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       Int
  content        String       @db.Text
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Order {
  id                Int       @id @default(autoincrement())
  listing           Listing      @relation(fields: [listingId], references: [id])
  listingId         Int
  buyer             User         @relation("BuyerOrders", fields: [buyerId], references: [id])
  buyerId           Int
  farmer            User         @relation("FarmerOrders", fields: [farmerId], references: [id])
  farmerId          Int
  quantity          Decimal     @db.Decimal(12, 3)
  unitPrice         Decimal     @db.Decimal(10, 2)
  totalPrice        Decimal     @db.Decimal(10, 2)
  deliveryMode      DeliveryMode @relation(fields: [deliveryModeId], references: [id])
  deliveryModeId    Int
  deliveryAddress   String?     @db.Text
  deliveryLatitude  Float?
  deliveryLongitude Float?
  status            OrderStatus  @default(PENDING)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  delivery Delivery?

  @@index([buyerId])
  @@index([farmerId])
  @@index([listingId])
  @@index([deliveryModeId])
}

model Delivery {
  id               Int         @id @default(autoincrement())
  order            Order          @relation(fields: [orderId], references: [id])
  orderId          Int         @unique
  driver           User?          @relation("DriverDeliveries", fields: [driverId], references: [id])
  driverId         Int?
  status           DeliveryStatus @default(PENDING)
  pickupLatitude   Float?
  pickupLongitude  Float?
  dropoffLatitude  Float?
  dropoffLongitude Float?
  distanceKm       Float?
  deliveryFee      Decimal?     @db.Decimal(10, 2)
  assignedAt       DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([driverId])
  @@index([status])
}

// Une session est un appareil connecte. Elle est ce qui rend exprimable un
// "deconnecte moi de cet appareil", ce qu'un sac plat de jetons ne permet pas :
// avant, une deconnexion ne revocait que l'un des jetons du compte, et les
// connexions concurrentes restaient valides.
model Session {
  id             Int       @id @default(autoincrement())
  user           User      @relation(fields: [userId], references: [id])
  userId         Int
  // Nullable : un agent ou une adresse IP sont absents plus souvent qu'ils ne
  // sont presents, et leur absence ne doit pas empecher de creer la session.
  userAgent      String?
  ip             String?
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  // Remplit quand la session est close. Une date plutot qu'un booleen : on peut
  // ainsi distinguer "deconnecte" de "expire", et purger par anticipation.
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        Int   @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  session   Session  @relation(fields: [sessionId], references: [id])
  sessionId Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  // Rempli quand ce jeton a ete remplace par un autre, au sein de la meme
  // session. C'est ce qui distingue une rotation d'une revocation, et permet de
  // distinguer une reconnexion legitime d'une reutilisation d'un jeton vole.
  rotatedAt     DateTime?
  // Le jeton qui a succede a celui-ci. Referencer le successeur permet de
  // repondre au client qui presente un jeton recentement tourne : sans cela la
  // fenetre de tolerance ne pourrait que le refuser, alors que son appel est
  // parfaitement legitime.
  replacedBy     RefreshToken?  @relation("TokenRotation", fields: [replacedById], references: [id])
  replacedById   Int?
  replaces       RefreshToken[] @relation("TokenRotation")
  createdAt      DateTime       @default(now())

  @@index([userId])
  @@index([sessionId])
}
