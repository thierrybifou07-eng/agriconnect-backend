# Base de données MySQL
DATABASE_URL="mysql://user:password@localhost:3306/agriconnect"

# Authentification
JWT_SECRET="change_this_secret_en_production"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_TTL_DAYS=30
# Nombre de sessions ouvertes simultanément par compte. Au-delà, la plus
# ancienne est fermée : un compte qui s'accumule depuis des appareils perdus
# resterait connectable indéfiniment.
SESSION_MAX_PER_USER=5
# Fenêtre de tolérance après le remplacement d'un jeton de rafraîchissement.
# Deux refreshs parallèles d'une même application mobile sont ordinaires ; sans
# ce délai, le serveur y verrait un vol et détruirait la session d'un
# utilisateur légitime. Au-delà, un jeton déjà remplacé est traité comme volé.
REFRESH_REUSE_GRACE_SECONDS=30

# Serveur
PORT=4000
# Origine(s) autorisée(s) par CORS, séparées par des virgules, ou '*' pour tout autoriser.
CORS_IO="http://localhost:5173"

# Adresse publique du front (Flutter, web). Sert à construire les liens envoyés
# par email : réinitialisation de mot de passe et vérification d'adresse.
# Le backend sert lui-même le formulaire à partir du lien, et redirige vers
# APP_URL une fois l'action faite : la variable reste donc nécessaire même si
# les liens pointent d'abord ici.
APP_URL="http://localhost:3000"

# Cloudinary (stockage des médias)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Emails transactionnels (SMTP générique : Gmail, SendGrid, Mailgun, etc.)
# Si SMTP_HOST est vide ou absent, les emails ne sont pas envoyés et le service
# journalise un avertissement : aucune inscription n'échoue pour autant.
# SMTP_HOST est le nom d'hôte du serveur SMTP (ex. smtp.gmail.com), et non une
# URL d'interface web comme Mailpit.
SMTP_HOST=
SMTP_PORT=587
# true pour un port 465 (TLS implicite), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Adresse d'expédition. Les serveurs SMTP refusent une adresse nue :
# utilisez la forme "Nom <adresse@domaine>".
EMAIL_SENDER="AgriConnect <no-reply@votre-domaine.com>"

# Piège à mail local (MailDev) : le serveur SMTP écoute sur 1025 et son
# interface web sur 1080. Ce sont deux ports différents — 1080 n'accepte pas
# SMTP, un envoi vers ce port échoue sans bruit.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# Interface web du piège à mail, pour relire les messages envoyés en dev.
MAILDEV_API_URL="http://localhost:1080"